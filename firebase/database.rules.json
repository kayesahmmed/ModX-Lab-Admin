{
  "rules": {
    ".read": false,
    ".write": false,
    "Resellers": {
      "$uid": {
         ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
         ".write": false
      }
    },
    "UsernameIndex": {
       ".read": false,
       ".write": false
    },
    "Keys": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },
    "AuditLogs": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },
    "User": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },
    "Seller": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },
    "update": {
      ".read": true,
      ".write": false
    }
  }
}
